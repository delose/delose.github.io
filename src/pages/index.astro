---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ogImage from '../assets/og-home.jpg';

// The page is the two products. Everything else on the site is secondary, so the
// writing is a short list at the bottom and the counts are never hardcoded.
const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const title = 'Gaby and Nope — two small, private apps';
const description =
	"Gaby has you rehearse the Spanish you'll actually speak in Spain, offline. Nope puts a pause page in front of the sites that eat your afternoon. No account, no ads, nothing sent anywhere.";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={ogImage} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>Two small apps.</h1>
				<p class="lede">
					<strong>Gaby</strong> has you rehearse the Spanish you'll actually speak in Spain.
					<strong>Nope</strong> puts a pause in front of the sites that eat your afternoon.
					Neither one keeps an account, shows an ad, or sends anything anywhere.
				</p>
			</section>

			<!-- ===================================================== Gaby -->
			<section class="product product--gaby" aria-labelledby="gaby-title">
				<div class="product__text">
					<p class="product__eyebrow">iPhone · on the App Store</p>
					<h2 id="gaby-title">Gaby: Speak Spanish</h2>
					<p class="product__tag">Rehearse it before you live it</p>
					<p>
						The pharmacy. The NIE appointment. The menú del día. Gaby puts you in the
						conversation before you're standing in it — you say your part out loud, and it
						tells you what you got wrong.
					</p>
					<ul class="product__facts">
						<li>24 situations, 100 lessons, three levels each</li>
						<li>Every sentence and correction written by a person</li>
						<li>Speech checked on the device — it makes no network requests at all</li>
						<li>Free to download, one $14.99 purchase, no subscription</li>
					</ul>
					<p class="product__links">
						<a class="btn" href="/gaby/">See Gaby</a>
						<a class="plain" href="https://apps.apple.com/app/id6790808283">
							Download on the App Store →
						</a>
					</p>
				</div>
				<div class="product__shots">
					<img
						src="/gaby/screens/01-situations.jpg"
						alt="Gaby on iPhone: the Situations list, scenes grouped by category"
						width="415"
						height="900"
					/>
					<img
						src="/gaby/screens/03-correction.jpg"
						alt="Gaby on iPhone: a correction naming the exact slip in what you just said"
						width="415"
						height="900"
					/>
				</div>
			</section>

			<!-- ===================================================== Nope -->
			<section class="product product--nope" aria-labelledby="nope-title">
				<div class="product__text">
					<p class="product__eyebrow">Safari and Chrome · coming soon</p>
					<h2 id="nope-title">Nope: Pause Distracting Sites</h2>
					<p class="product__tag">Pause before you scroll</p>
					<p>
						A calm pause page in front of the sites you block. Leaving takes one tap.
						Opening a site means a short wait and a few minutes from a daily allowance, so
						“just five minutes” can't turn into the whole afternoon.
					</p>
					<ul class="product__facts">
						<li>Safari on iPhone and Mac, and Chrome on a computer</li>
						<li>The pause page shows the first thing on your own to-do list</li>
						<li>Loosening a rule waits out a cooldown; tightening applies at once</li>
						<li>Free. Everything it keeps stays on the device</li>
					</ul>
					<p class="product__links">
						<a class="btn" href="/nope/">See Nope</a>
						<a class="plain" href="/nope/support/">Support and FAQ →</a>
					</p>
				</div>
				<div class="product__shots">
					<img
						src="/nope/screens/01-pause-page.jpg"
						alt="Nope on iPhone: the pause page for a blocked site, with Do this instead and Close tab"
						width="414"
						height="900"
						loading="lazy"
					/>
					<img
						src="/nope/screens/03-streaks.jpg"
						alt="Nope on iPhone: streaks counting the days since each blocked site was last opened"
						width="414"
						height="900"
						loading="lazy"
					/>
				</div>
			</section>

			<!-- ================================================== Writing -->
			<section class="writing">
				<h2>Writing</h2>
				<p class="writing__lede">
					Notes from the day job: microservices, event-driven architecture and AI agents,
					worked through a reference finance system.
				</p>
				<ul class="writing__list">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							</li>
						))
					}
				</ul>
				<p class="writing__more">
					<a class="plain" href="/blog">All posts →</a>
					<a class="plain" href="https://github.com/delose/personal-finance-management-system">
						The code on GitHub →
					</a>
				</p>
			</section>

			<p class="byline">Made by Eugene De Los Santos.</p>
		</main>
		<Footer />

		<style>
			main {
				box-sizing: border-box;
				width: 100%;
				max-width: 1040px;
				margin: auto;
				padding: 2.5rem 1rem 1rem;
			}

			.product,
			.product__text,
			.product__shots {
				min-width: 0;
			}

			/* ---------------------------------------------------------- intro */
			.intro {
				margin-bottom: 4rem;
			}

			.intro h1 {
				font-size: 3rem;
				line-height: 1.1;
				margin: 0 0 1rem;
			}

			.lede {
				font-size: 1.25rem;
				line-height: 1.6;
				max-width: 46ch;
				margin: 0;
				color: #4b5563;
			}

			.lede strong {
				color: rgb(var(--black));
			}

			/* -------------------------------------------------------- products */
			.product {
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
				gap: clamp(1.5rem, 4vw, 3.5rem);
				align-items: center;
				padding: clamp(1.75rem, 3vw, 2.75rem);
				margin-bottom: 2.5rem;
				border: 1px solid var(--edge);
				border-left: 6px solid var(--mark);
				border-radius: 16px;
				background: var(--tint);
			}

			.product--gaby {
				--mark: #c1440e;
				--tint: #fdf6f2;
				--edge: #f0d9cd;
			}

			.product--nope {
				--mark: #2d5b4e;
				--tint: #f4f7f5;
				--edge: #d3e0da;
			}

			.product__eyebrow {
				margin: 0 0 0.6rem;
				font-size: 0.8rem;
				font-weight: 700;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: var(--mark);
			}

			.product h2 {
				font-size: 2rem;
				line-height: 1.15;
				margin: 0;
			}

			.product__tag {
				margin: 0.3rem 0 1rem;
				font-size: 1.15rem;
				font-style: italic;
				color: var(--mark);
			}

			.product p {
				line-height: 1.6;
			}

			.product__facts {
				margin: 1.25rem 0 1.5rem;
				padding: 0;
				list-style: none;
				font-size: 0.95rem;
			}

			.product__facts li {
				position: relative;
				margin-bottom: 0.5rem;
				padding-left: 1.4rem;
				line-height: 1.5;
			}

			.product__facts li::before {
				content: "";
				position: absolute;
				top: 0.55em;
				left: 0.15rem;
				width: 0.5rem;
				height: 0.5rem;
				border-radius: 50%;
				background: var(--mark);
			}

			.product__links {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.75rem 1.5rem;
				margin: 0;
			}

			.btn {
				display: inline-block;
				padding: 0.7rem 1.4rem;
				border-radius: 8px;
				background: var(--mark);
				color: #fff;
				font-weight: 700;
				font-size: 1rem;
				text-decoration: none;
			}

			.btn:hover {
				color: #fff;
				filter: brightness(1.12);
			}

			.plain {
				font-size: 0.95rem;
				font-weight: 600;
				color: var(--mark, var(--accent));
			}

			/* Two real captures per product — the only proof that matters here. They
			   are 415x900, so a fixed height with a top crop keeps a pair of them
			   beside the copy instead of towering over it (same reason as the Gaby
			   page's own strip). */
			.product__shots {
				display: flex;
				justify-content: center;
				gap: 0.9rem;
			}

			.product__shots img {
				width: 50%;
				max-width: 190px;
				height: 340px;
				object-fit: cover;
				object-position: top center;
				border-radius: 14px;
				border: 1px solid var(--edge);
				box-shadow: 0 10px 24px rgba(15, 18, 25, 0.12);
				background: #fff;
			}

			/* Nope's captures are App Store cards — a headline above the device — so
			   a top crop would show the headline and nothing else. Let them keep
			   their own aspect instead; the box then wraps them exactly. */
			.product--nope .product__shots img {
				width: auto;
				max-width: none;
				object-fit: fill;
			}

			/* --------------------------------------------------------- writing */
			.writing {
				margin: 4rem 0 0;
				padding-top: 2.5rem;
				border-top: 1px solid #e5e7eb;
			}

			.writing h2 {
				font-size: 1.35rem;
				margin: 0 0 0.5rem;
			}

			.writing__lede {
				margin: 0;
				font-size: 1rem;
				max-width: 60ch;
				color: #6b7280;
			}

			.writing__list {
				margin: 1.25rem 0 0;
				padding: 0;
				list-style: none;
			}

			.writing__list li {
				padding: 0.45rem 0;
				border-bottom: 1px solid #eef0f3;
			}

			.writing__list a {
				font-size: 1rem;
				font-weight: 600;
				color: rgb(var(--black));
				text-decoration: none;
			}

			.writing__list a:hover {
				text-decoration: underline;
			}

			.writing .plain {
				color: #4b5563;
			}

			.writing .plain:hover {
				color: var(--accent);
			}

			.writing__more {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem 1.5rem;
				margin: 1.25rem 0 0;
			}

			.byline {
				margin: 3rem 0 0;
				font-size: 0.9rem;
				color: #6b7280;
			}

			/* ------------------------------------------------------ responsive */
			@media (max-width: 820px) {
				.product {
					grid-template-columns: 1fr;
					align-items: start;
				}

				.product__shots {
					order: -1;
					justify-content: flex-start;
				}
			}

			@media (max-width: 520px) {
				main {
					padding-top: 1.75rem;
				}

				.intro h1 {
					font-size: 2.25rem;
				}

				.lede {
					font-size: 1.1rem;
				}

				.product {
					padding: 1.4rem;
					border-left-width: 5px;
				}

				.product h2 {
					font-size: 1.6rem;
				}

				.product__shots img {
					height: 260px;
				}

				.btn {
					width: 100%;
					text-align: center;
				}
			}
		</style>
	</body>
</html>
