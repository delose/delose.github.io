---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ogImage from '../assets/og-home.jpg';

// The page is the two products, laid out like a store listing so both fit in the
// first screen. Everything else on the site is secondary, so the writing is a
// short list at the bottom and the counts are never hardcoded.
const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const title = 'Gaby and Nope — two small, private apps';
const description =
	"Gaby has you rehearse the Spanish you'll actually speak in Spain, offline. Nope puts a pause page in front of the sites that eat your afternoon. No account, no ads, nothing sent anywhere.";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={ogImage} />
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">
				Two small apps. Both offline, no account, nothing sent anywhere.
			</h1>

			<div class="apps">
				<!-- ================================================= Gaby -->
				<section class="app app--gaby" aria-labelledby="gaby-title">
					<header class="app__head">
						<img class="app__icon" src="/gaby/icon.svg" alt="" width="68" height="68" />
						<div class="app__id">
							<h2 id="gaby-title">Gaby: Speak Spanish</h2>
							<p class="app__tag">Rehearse it before you live it</p>
							<p class="app__meta">iPhone · Education</p>
						</div>
						<a
							class="app__get"
							href="https://apps.apple.com/app/id6790808283"
							aria-label="Get Gaby on the App Store">Get</a
						>
					</header>

					<div class="app__shots">
						<img
							src="/gaby/screens/01-situations.jpg"
							alt="Gaby: the Situations list, scenes grouped by category"
							width="415"
							height="900"
						/>
						<img
							src="/gaby/screens/03-correction.jpg"
							alt="Gaby: a correction naming the exact slip in what you just said"
							width="415"
							height="900"
						/>
						<img
							src="/gaby/screens/05-collection.jpg"
							alt="Gaby: the collection of Spanish paintings and places"
							width="415"
							height="900"
						/>
					</div>

					<p class="app__desc">
						The pharmacy. The NIE appointment. The menú del día. You say your part out
						loud and Gaby tells you what you got wrong — every sentence and every
						correction written by a person.
					</p>

					<dl class="app__info">
						<div>
							<dt>Price</dt>
							<dd>Free · one $14.99 purchase</dd>
						</div>
						<div>
							<dt>Inside</dt>
							<dd>24 situations · 100 lessons</dd>
						</div>
						<div>
							<dt>Privacy</dt>
							<dd>Makes no network requests</dd>
						</div>
					</dl>

					<p class="app__links">
						<a class="plain" href="/gaby/">More about Gaby →</a>
					</p>
				</section>

				<!-- ================================================= Nope -->
				<section class="app app--nope" aria-labelledby="nope-title">
					<header class="app__head">
						<img class="app__icon" src="/nope/icon.svg" alt="" width="68" height="68" />
						<div class="app__id">
							<h2 id="nope-title">Nope: Pause Distracting Sites</h2>
							<p class="app__tag">Pause before you scroll</p>
							<p class="app__meta">Chrome · Safari coming soon</p>
						</div>
						<a
							class="app__get"
							href="https://chromewebstore.google.com/detail/langginbabbklialnaaiifkjhpekfjop"
							aria-label="Get Nope on the Chrome Web Store">Get</a
						>
					</header>

					<div class="app__shots">
						<img
							src="/nope/screens/01-pause-page.jpg"
							alt="Nope: the pause page for a blocked site, with Do this instead and Close tab"
							width="414"
							height="900"
							loading="lazy"
						/>
						<img
							src="/nope/screens/02-block-sites.jpg"
							alt="Nope: the list of sites you have chosen to block"
							width="414"
							height="900"
							loading="lazy"
						/>
						<img
							src="/nope/screens/03-streaks.jpg"
							alt="Nope: streaks counting the days since each blocked site was last opened"
							width="414"
							height="900"
							loading="lazy"
						/>
					</div>

					<p class="app__desc">
						A calm pause page in front of the sites you block, showing the first thing on
						your own to-do list. Leaving takes one tap; opening the site costs a short
						wait and a few minutes of a daily allowance.
					</p>

					<dl class="app__info">
						<div>
							<dt>Price</dt>
							<dd>Free</dd>
						</div>
						<div>
							<dt>Rules</dt>
							<dd>Loosening one waits out a cooldown</dd>
						</div>
						<div>
							<dt>Privacy</dt>
							<dd>Nothing leaves the device</dd>
						</div>
					</dl>

					<p class="app__links">
						<a class="plain" href="/nope/">More about Nope →</a>
						<a class="plain" href="/nope/support/">Support →</a>
					</p>
				</section>
			</div>

			<!-- ============================================== Writing -->
			<section class="writing">
				<h2>Writing</h2>
				<p class="writing__lede">
					Notes from the day job: microservices, event-driven architecture and AI agents,
					worked through a reference finance system.
				</p>
				<ul class="writing__list">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							</li>
						))
					}
				</ul>
				<p class="writing__more">
					<a class="plain" href="/blog">All posts →</a>
					<a class="plain" href="https://github.com/delose/personal-finance-management-system">
						The code on GitHub →
					</a>
				</p>
			</section>

			<p class="byline">Made by Eugene De Los Santos.</p>
		</main>
		<Footer />

		<style>
			main {
				box-sizing: border-box;
				width: 100%;
				max-width: 1080px;
				margin: auto;
				padding: 2rem 1rem 1rem;
			}

			/* ------------------------------------------------------ lede */
			/* One line, deliberately small: the two cards are the page, and
			   they only both fit above the fold if nothing sits on top. */
			.page-title {
				max-width: 70ch;
				margin: 0 0 1.75rem;
				font-size: 1.25rem;
				font-weight: 600;
				line-height: 1.5;
				color: #4b5563;
			}

			/* ------------------------------------------------- store grid */
			.apps {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1.5rem;
			}

			.app {
				display: flex;
				flex-direction: column;
				min-width: 0;
				padding: 1.5rem;
				border: 1px solid #e6e8ec;
				border-radius: 18px;
				background: #fff;
				box-shadow:
					0 1px 2px rgba(16, 24, 40, 0.04),
					0 10px 28px rgba(16, 24, 40, 0.06);
			}

			.app--gaby {
				--mark: #c1440e;
			}

			.app--nope {
				--mark: #2d5b4e;
			}

			.app__head {
				display: grid;
				grid-template-columns: auto minmax(0, 1fr) auto;
				gap: 0 0.9rem;
				align-items: center;
			}

			.app__icon {
				display: block;
				width: 68px;
				height: 68px;
				border-radius: 16px;
				border: 1px solid #e6e8ec;
				background: #fff;
			}

			.app__id {
				min-width: 0;
			}

			.app h2 {
				margin: 0;
				font-size: 1.15rem;
				line-height: 1.25;
			}

			.app__tag {
				margin: 0.15rem 0 0;
				font-size: 0.9rem;
				color: #6b7280;
			}

			.app__meta {
				margin: 0.3rem 0 0;
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: var(--mark);
			}

			.app__get {
				display: inline-block;
				padding: 0.45rem 1.2rem;
				border-radius: 999px;
				background: var(--mark);
				color: #fff;
				font-size: 0.9rem;
				font-weight: 700;
				text-decoration: none;
				white-space: nowrap;
			}

			.app__get:hover {
				color: #fff;
				filter: brightness(1.12);
			}

			/* Thumbnails, store-strip size. Gaby's are raw phone captures, so
			   they crop from the top; Nope's are App Store cards with a
			   headline above the device, so they crop past it. */
			.app__shots {
				display: flex;
				gap: 0.6rem;
				margin: 1.25rem 0 0;
			}

			.app__shots img {
				flex: 1 1 0;
				width: 0;
				min-width: 0;
				height: 210px;
				object-fit: cover;
				object-position: top center;
				border-radius: 10px;
				border: 1px solid #e6e8ec;
				background: #fff;
			}

			.app--nope .app__shots img {
				object-position: center 92%;
			}

			.app__desc {
				margin: 1.1rem 0 0;
				font-size: 0.95rem;
				line-height: 1.6;
			}

			/* The strip a store puts under the screenshots. */
			.app__info {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				margin: 1.25rem 0 0;
				padding-top: 1rem;
				border-top: 1px solid #eef0f3;
			}

			.app__info > div {
				padding: 0 0.75rem;
				border-left: 1px solid #eef0f3;
			}

			.app__info > div:first-child {
				padding-left: 0;
				border-left: 0;
			}

			.app__info dt {
				font-size: 0.68rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: #9aa1ab;
			}

			.app__info dd {
				margin: 0.3rem 0 0;
				font-size: 0.82rem;
				line-height: 1.4;
				color: #374151;
			}

			/* auto top margin: both cards' link rows sit on the same line. */
			.app__links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem 1.25rem;
				margin: auto 0 0;
				padding-top: 1.25rem;
			}

			.plain {
				font-size: 0.9rem;
				font-weight: 600;
				color: var(--mark, var(--accent));
			}

			/* --------------------------------------------------- writing */
			.writing {
				margin: 3.5rem 0 0;
				padding-top: 2.5rem;
				border-top: 1px solid #e5e7eb;
			}

			.writing h2 {
				font-size: 1.35rem;
				margin: 0 0 0.5rem;
			}

			.writing__lede {
				margin: 0;
				font-size: 1rem;
				max-width: 60ch;
				color: #6b7280;
			}

			.writing__list {
				margin: 1.25rem 0 0;
				padding: 0;
				list-style: none;
			}

			.writing__list li {
				padding: 0.45rem 0;
				border-bottom: 1px solid #eef0f3;
			}

			.writing__list a {
				font-size: 1rem;
				font-weight: 600;
				color: rgb(var(--black));
				text-decoration: none;
			}

			.writing__list a:hover {
				text-decoration: underline;
			}

			.writing .plain {
				color: #4b5563;
			}

			.writing .plain:hover {
				color: var(--accent);
			}

			.writing__more {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem 1.5rem;
				margin: 1.25rem 0 0;
			}

			.byline {
				margin: 3rem 0 0;
				font-size: 0.9rem;
				color: #6b7280;
			}

			/* ------------------------------------------------ responsive */
			@media (max-width: 900px) {
				.apps {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 520px) {
				main {
					padding-top: 1.5rem;
				}

				.page-title {
					font-size: 1.1rem;
					margin-bottom: 1.5rem;
				}

				.app {
					padding: 1.25rem;
				}

				.app__head {
					grid-template-columns: auto minmax(0, 1fr);
				}

				.app__icon {
					width: 56px;
					height: 56px;
					border-radius: 13px;
				}

				.app__get {
					grid-column: 1 / -1;
					justify-self: start;
					margin-top: 0.9rem;
				}

				.app__shots img {
					height: 170px;
				}

				.app__info {
					grid-template-columns: 1fr;
					gap: 0.75rem;
				}

				.app__info > div {
					padding: 0;
					border-left: 0;
				}
			}
		</style>
	</body>
</html>
